# Copiar a .env y sustituir TODOS los marcadores antes de arrancar.
DATA_DIR=./data
PRODUCT_DB=novamercado
PRODUCT_DB_USER=novamercado
PRODUCT_DB_PASSWORD=REEMPLAZAR
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=REEMPLAZAR
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=REEMPLAZAR
# Generar con Fernet.generate_key() antes de arrancar.
AIRFLOW_FERNET_KEY=REEMPLAZAR
AIRFLOW_SECRET_KEY=REEMPLAZAR
AIRFLOW_UID=50000
API_PORT=8000
MLFLOW_PORT=5001
AIRFLOW_PORT=8080
# URI para ejecutar la API desde el host; Compose usa http://mlflow:5000.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MODEL_NAME=novamercado-histgradientboosting
MODEL_CACHE_DIR=./models
MODEL_REFRESH_SECONDS=30
MLFLOW_HTTP_REQUEST_TIMEOUT=3
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
